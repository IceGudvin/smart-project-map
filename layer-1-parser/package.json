{
  "name": "@smart-map/layer-1-parser",
  "version": "0.1.0",
  "description": "Static analysis layer: extracts routes, http-calls, schemas, env-config from TypeScript and Python projects",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@smart-map/shared": "workspace:*",
    "@ast-grep/napi": "^0.25.0",
    "ts-morph": "^23.0.0",
    "glob": "^11.0.0",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "@types/node": "^22.0.0"
  }
}
