{
  "name": "smart-project-map",
  "version": "0.1.0",
  "description": "Interactive project architecture map",
  "private": true,
  "workspaces": [
    "shared",
    "layer-0-cli",
    "layer-1-parser",
    "layer-2-graph",
    "layer-3-server",
    "layer-4-ui",
    "layer-5-dataflow"
  ],
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r run dev",
    "typecheck": "pnpm -r run typecheck",
    "clean": "pnpm -r run clean",
    "ui": "pnpm --filter @smart-map/layer-4-ui run dev -- --open",
    "server": "tsx layer-3-server/src/index.ts"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
